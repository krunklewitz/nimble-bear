        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified"
      }
    },
    {
      "id": "feature.hexbinder.rite-of-mending",
      "name": "Rite of Mending",
      "text": "During a Field Rest, you can cast Life Bloom for 0 mana. You and your target can each spend any equal number of Hit Dice, and each creature it heals regains 10 HP per pair.",
      "effects": [
        {
          "type": "text"
        }
      ],
      "automation": "manual",
      "manualNote": "During a Field Rest, cast Life Bloom without spending mana; you and your target each spend the same number of Hit Dice by hand, and each healed creature regains 10 HP per pair.",
      "source": {
        "file": "Hexbinder3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified"
      }
    },
    {
      "id": "feature.hexbinder.consult-the-bones",
      "name": "Consult the BONES",
      "text": "1/Safe Rest. Spend 10 min performing a ceremony to obtain information not otherwise available to you on a successful Insight check; rolled with disadvantage.",
      "effects": [
        {
          "type": "grant",
          "action": {
            "id": "action.hexbinder.consult-the-bones",
            "name": "Consult the BONES",
            "kind": "ability",
            "limit": {
              "uses": "1",
              "per": "safeRest"
            },
            "text": "1/Safe Rest. Spend 10 min performing a ceremony to obtain information not otherwise available to you on a successful Insight check; rolled with disadvantage."
          }
        }
      ],
      "automation": "partial",
      "manualNote": "Roll the Insight check with disadvantage yourself; the GM decides what you learn.",
