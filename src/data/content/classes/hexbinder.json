    {
      "id": "feature.hexbinder.soothsayer",
      "name": "Soothsayer",
      "text": "Whenever combat begins, roll a Futuresight Die (1d4). (Reach 4) Expend it to increase or decrease any die by that much. It expires at the end of combat if unused.",
      "effects": [
        {
          "type": "resource",
          "resource": {
            "id": "resource.hexbinder.futuresight",
            "name": "Futuresight Dice",
            "max": "var.futuresightDice",
            "recover": [
              {
                "on": "initiative",
                "amount": "all"
              }
            ],
            "lose": [
              "combatEnd"
            ],
            "dice": {
              "die": "1d4",
              "rolled": "gained"
            }
          }
        }
      ],
      "automation": "partial",
      "manualNote": "Spend a Futuresight Die on any die within Reach 4 (yours or another creature’s) and add or subtract its value by hand. Changing Dice. A die can’t be changed above its max value. As usual, if a Primary Die is reduced to 1, it misses; if increased to its max value, it crits.",
      "source": {
        "file": "Hexbinder3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 5,
        "status": "verified",
        "note": "manualNote includes the “Changing Dice” sidebar printed under Soothsayer. FAQ (Hexbinder3.0.pdf PDF 8, printed 14): “Futuresight Dice. They can change any die, including the tens die of a d44, d66, or d88.”"
      }
    },
    {
