  "features": [
    {
      "id": "feature.hexbinder.hex",
      "name": "Hex",
      "text": "Reach 4, Action: 1d4 damage. On hit: +LVL damage, OR apply an Affliction. On crit: do both.",
      "effects": [
        {
          "type": "grant",
          "action": {
            "id": "action.hexbinder.hex",
            "name": "Hex",
            "kind": "attack",
            "actions": 1,
            "reach": "4",
            "roll": {
              "kind": "damage",
              "dice": "1d4"
            },
            "text": "Reach 4, Action: 1d4 damage. On hit: +LVL damage, OR apply an Affliction. On crit: do both."
          }
        }
      ],
      "automation": "partial",
      "manualNote": "On a hit, either add LVL to the damage by hand or apply one of your Afflictions to the target; on a crit, do both.",
      "source": {
        "file": "Hexbinder3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified",
        "note": "No damage type is printed for Hex, so none is set."
      }
    },
    {
      "id": "feature.hexbinder.afflictions",
      "name": "Afflictions",
      "text": "You know the Withered and Frenzied Afflictions.",
      "effects": [
        {
          "type": "grantOptions",
          "pool": "hexbinder.afflictions",
          "ids": [
            "feature.hexbinder.afflictions.withered",
            "feature.hexbinder.afflictions.frenzied"
          ]
        }
      ],
      "automation": "manual",
      "manualNote": "hexbinder.afflictions.withered (Withered) and feature.hexbinder.afflictions.frenzied (Frenzied). You can Afflict a max of 1 creature at a time with a max of INT different Afflictions. Afflictions last for as long as you maintain Concentration (DC 10 STR save when crit).",
      "source": {
        "file": "Hexbinder3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified",
        "note": "The Afflictions rule paragraph in manualNote is printed above the Afflictions list on PDF 4, printed 6."
      }
    },
    {
      "id": "feature.hexbinder.mana-and-tier-1-spells",
      "name": "Mana and Tier 1 Spells",
      "text": "You unlock tier 1 Hexbinder spells and a mana pool to cast them. Your max mana pool is always equal to WIL+LVL and recharges on a Safe Rest.",
      "effects": [
        {
          "type": "resource",
          "resource": {
            "id": "resource.mana",
            "name": "Mana",
            "max": "WIL+LVL",
            "recover": [
              {
                "on": "safeRest",
                "amount": "all"
              }
            ]
          }
        },
        {
          "type": "spells",
          "list": "hexbinder",
          "maxTier": 1
        }
      ],
      "automation": "full",
      "source": {
        "file": "Hexbinder3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified"
      }
    },
    {
      "id": "feature.hexbinder.diminution",
      "name": "Diminution",
      "text": "Reduce the mana cost of spells by 1 for each condition chosen.\n• Humble. The Range/Reach of the spell is halved.\n• Slow. Spend 1 additional action.\n• Weak. Roll with disadvantage.\nChoose each condition only once per spell. You can’t choose an effect that a spell does not have (e.g., Humble on a spell with no Range/Reach, Weak on a spell with no roll).",
      "effects": [
        {
          "type": "text"
        }
      ],
      "automation": "manual",
      "manualNote": "A casting option: when you cast a spell, pick any of Humble, Slow or Weak (each once) and pay 1 less mana per pick; halve the Range/Reach, spend the extra action or roll with disadvantage by hand.",
      "source": {
        "file": "Hexbinder3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified",
        "note": "The last sentence is an italic note printed under the three conditions; kept in text. FAQ (Hexbinder3.0.pdf PDF 8, printed 14): “Coven. Spells from your Coven school can be upcast (up to your highest tier) and Diminished.”"
      }
    },
    {
      "id": "feature.hexbinder.subclass",
      "name": "Hexbinder Subclass",
      "text": "Choose a Hexbinder subclass.",
      "effects": [
        {
          "type": "choice",
          "choice": {
            "id": "choice.hexbinder.subclass",
            "prompt": "Choose a Hexbinder subclass.",
            "count": 1,
            "from": {
              "kind": "subclass"
            }
