  "features": [
    {
      "id": "feature.shepherd.keeper-of-life-death",
      "name": "Keeper of Life & Death",
      "text": "You know the Radiant & Necrotic cantrips.",
      "effects": [
        {
          "type": "spells",
          "schools": [
            "radiant",
            "necrotic"
          ],
          "cantrips": true,
          "maxTier": 0
        }
      ],
      "automation": "full",
      "source": {
        "file": "Shepherd3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified"
      }
    },
    {
      "id": "feature.shepherd.my-buddy",
      "name": "My Buddy!",
      "text": "Learn the Lifebinding Spirit cantrip.",
      "effects": [
        {
          "type": "spells",
          "extra": [
            "spell.shepherd.lifebinding-spirit"
          ]
        },
        {
          "type": "grant",
          "action": {
            "id": "action.shepherd.spirit-harm",
            "name": "Harm",
            "kind": "attack",
            "actions": 1,
            "reach": "4",
            "roll": {
              "kind": "damage",
              "dice": "1d8+STR",
              "damageType": "radiant",
              "ignoresArmor": true
            },
            "text": "Harm. 1 Action: It attacks for 1d8+STR radiant damage (ignoring Armor).",
            "creature": "companion"
          }
        },
        {
          "type": "grant",
          "action": {
            "id": "action.shepherd.spirit-mend",
            "name": "Mend",
            "kind": "ability",
            "actions": 1,
            "reach": "4",
            "roll": {
              "kind": "heal",
              "dice": "WIL d20"
            },
            "text": "Mend. 1 Action: (WIL/Safe Rest) It restores WIL d20 HP to a Dying creature.",
            "creature": "companion",
            "cost": {
              "resource": {
                "id": "resource.shepherd.mend",
                "amount": "1"
              }
            }
          }
        },
        {
          "type": "resource",
          "resource": {
            "id": "resource.shepherd.mend",
            "name": "Mend",
            "max": "WIL",
            "recover": [
              {
                "on": "safeRest",
                "amount": "all"
              }
            ]
          }
        }
      ],
      "automation": "partial",
      "manualNote": "Harm and Mend come from the Lifebinding Spirit cantrip (Shepherd3.0.pdf PDF 4, printed 7). Add the cantrip's High Levels bonus (+STR damage every 5 levels) to Harm by hand. Mend only targets a Dying creature.",
      "source": {
        "file": "Shepherd3.0.pdf",
        "version": "3.0",
        "pdfPage": 3,
        "printedPage": 4,
        "status": "verified",
        "note": "Harm/Mend action data and text taken from the Lifebinding Spirit cantrip, PDF 4, printed 7 (checked against the page image). Mend's WIL/Safe Rest uses are a resource so other features (Guardian Spirit) can spend them. Spirit actions count as the companion for Rushed Attacks (PDF 4 sidebar: “You and your companion use the same action pool, but count as different creatures.”)."
      }
    },
    {
      "id": "feature.shepherd.mana-and-unlock-tier-1-spells",
      "name": "Mana and Unlock Tier 1 Spells",
      "text": "You unlock tier 1 Radiant & Necrotic spells and gain a mana pool to cast them. This mana pool’s max is always equal to (WIL×3)+LVL and recharges on a Safe Rest.",
      "effects": [
        {
          "type": "resource",
          "resource": {
            "id": "resource.mana",
            "name": "Mana",
            "max": "(WIL*3)+LVL",
            "recover": [
              {
                "on": "safeRest",
                "amount": "all"
              }
            ]
          }
        },
        {
          "type": "spells",
          "schools": [
            "radiant",
            "necrotic"
          ],
          "maxTier": 1
        }
      ],
      "automation": "full",
